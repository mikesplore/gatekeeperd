# Gatekeeperd host deployment settings (no application secrets).
# Install: sudo install -m 0644 deploy.env.example /etc/gatekeeperd/deploy.env
# Then set DEPLOY_GATEWAY_URL to your public Gatekeeperd API origin.

DEPLOY_APP_ENV_FILE=/etc/gatekeeperd/gatekeeperd.env
DEPLOY_GATEWAY_URL=https://gateapi.example.com
DEPLOY_SOAK_SECONDS=30
DEPLOY_NGINX_DRAIN_TIMEOUT_SECONDS=620
DEPLOY_BLUE_PORT=18081
DEPLOY_GREEN_PORT=18082
DEPLOY_LEGACY_PORT=8080
