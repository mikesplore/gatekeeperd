# =============================================================================
# Gatekeeperd — environment configuration
# Copy to .env and fill in values before running deploy.sh or the app locally.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# Use Docker service hostnames (postgres) when running via deploy.sh.
# Use localhost when running the app directly on the host machine.
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/gatekeeper
DB_USER=gatekeeper
DB_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Redis (required)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# JWT admin auth (required)
# -----------------------------------------------------------------------------
JWT_SECRET=changeme-use-a-long-random-string
JWT_ISSUER=gatekeeperd
JWT_AUDIENCE=gatekeeperd-admin

# Initial admin account — used ONLY on first startup when no users exist yet.
# After the first user is created these are ignored (change password via DB or add a reset flow).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# -----------------------------------------------------------------------------
# Paystack payments
# Required for client self-service paywall (Pay Now) and webhooks.
# Use sk_test_ / pk_test_ keys in staging; sk_live_ / pk_live_ in production.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Public HTTPS URL where gatekeeperd is reachable from the internet.
# Used to build the Paystack browser return URL:
#   {GATEKEEPER_PUBLIC_URL}/api/gate/payment/callback?project={slug}
# Example: https://gateapi.mikesplore.me
# Do NOT include a trailing slash.
GATEKEEPER_PUBLIC_URL=https://gateapi.mikesplore.me
SCRIBED_CALLBACK_URL=
SCRIBED_INTEGRATION_SECRET=
SCRIBED_API_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# M-Pesa Daraja (optional standalone provider)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://gateapi.example.com/api/mpesa/callback

# Shown on blocked payment pages and in API payment_required responses.
SUPPORT_CONTACT_EMAIL=you@example.com

# Paystack webhook URL (configure in Paystack dashboard — not an env var here):
#   {GATEKEEPER_PUBLIC_URL}/api/paystack/webhook

# -----------------------------------------------------------------------------
# CORS — admin dashboard origins (comma-separated, include scheme)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://gatekeeperd.mikesplore.me,http://localhost:5173

# -----------------------------------------------------------------------------
# Docker / infrastructure (optional)
# -----------------------------------------------------------------------------
DOCKER_SOCKET=unix:///var/run/docker.sock
GATEKEEPER_INTERNAL_NETWORK=gatekeeper-internal
# Optional security allowlists. Leave empty to preserve unrestricted legacy behavior.
#DOCKER_ALLOWED_REGISTRIES=docker.io,ghcr.io
#DOCKER_ALLOWED_VOLUME_ROOTS=/srv/gatekeeperd/volumes

# -----------------------------------------------------------------------------
# Nginx configuration paths (optional)
# Defaults are standard Ubuntu/Debian paths. Override if you use custom paths.
# -----------------------------------------------------------------------------
#NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
#NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
#NGINX_SSL_CERT_PATH=/etc/letsencrypt/live

# -----------------------------------------------------------------------------
# Gating behaviour (optional)
# FAIL_MODE=open  → allow traffic if Redis and Postgres are both down
# FAIL_MODE=closed → block traffic if Redis and Postgres are both down
# -----------------------------------------------------------------------------
DEFAULT_GRACE_PERIOD_DAYS=3
FAIL_MODE=open
AUTOBLOCKER_INTERVAL_MINUTES=60

# Payment reconciliation job (optional)
# RECONCILIATION_STALE_MINUTES=30
# RECONCILIATION_INTERVAL_MINUTES=15
