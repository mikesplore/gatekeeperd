# =============================================================================
# Gatekeeperd environment configuration
# Copy to .env and replace placeholders with local or deployment values.
# Variable names in this file are kept in sync with the maintained .env.
# =============================================================================

# Database
DB_URL=jdbc:postgresql://postgres:5432/gatekeeper
DB_USER=gatekeeper
DB_PASSWORD=replace-me
GATEKEEPERD_ENVIRONMENT=DEV

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Admin authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=gatekeeperd
JWT_AUDIENCE=gatekeeperd-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://gateapi.example.com/api/mpesa/callback
MPESA_CALLBACK_TOKEN=replace-with-a-random-token-at-least-32-characters-long
MPESA_RATE_LIMIT_WINDOW_SECONDS=60
MPESA_RATE_LIMIT_IP_MAX=120
MPESA_RATE_LIMIT_SERVICE_MAX=30
MPESA_RATE_LIMIT_PHONE_MAX=3
MPESA_INITIATION_COOLDOWN_SECONDS=60

# Public URLs and support
GATEKEEPER_PUBLIC_URL=https://gateapi.example.com
GATEKEEPER_FRONTEND_URL=https://gatekeeperd.example.com
SUPPORT_CONTACT_EMAIL=support@example.com
PASSWORD_RESET_URL=https://gatekeeperd.example.com/reset-password
CORS_ALLOWED_ORIGINS=https://gatekeeperd.example.com,http://localhost:5173

# Scribed document service
SCRIBED_BASE_URL=http://localhost:8001
SCRIBED_API_CLIENT_TOKEN=

# Email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Docker and deployment
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_ALLOW_PUBLIC_PORT_BINDINGS=false
GATEKEEPER_INTERNAL_NETWORK=gk-internal
DEPLOYMENT_SECRETS_KEY=

# GitHub App integration
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=https://gateapi.example.com/api/github/callback

# Nginx and payment gating
GATEKEEPERD_SELF_DOMAIN=gateapi.example.com
GATEKEEPER_NGINX_AUTH_UPSTREAM=127.0.0.1:8080
NGINX_DEPLOYMENT_UPSTREAMS_ENABLED=false
DEFAULT_GRACE_PERIOD_DAYS=3
FAIL_MODE=closed
